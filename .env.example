# Required: OpenAI API key for chat functionality
OPENAI_API_KEY=sk-proj-...

# Required: Neynar API key for AI profile creation
NEYNAR_API_KEY=

# Optional: Persist created AI Pet profile across deployments
# These are populated when you create an AI profile via the UI
AI_PET_PROFILE_FID=
AI_PET_PROFILE_SIGNER_UUID=

# Optional: Backend URL (for production deployments)
APP_BACKEND_URL=
